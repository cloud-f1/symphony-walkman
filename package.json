{
  "name": "symphony-walkman",
  "version": "0.17.9",
  "private": true,
  "type": "module",
  "description": "Claude Code plugin: a pedestrian-signal board that shows which Jira card Claude is working on.",
  "license": "MIT",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.6",
    "pnpm": ">=12"
  },
  "scripts": {
    "test": "node --experimental-strip-types --no-warnings --test checks/*.check.ts && claude plugin test",
    "typecheck": "tsc -p tsconfig.plugin.json",
    "walkman": "node cli/walkman.mjs",
    "release:check": "node --experimental-strip-types --no-warnings scripts/release.mjs check",
    "release": "node --experimental-strip-types --no-warnings scripts/release.mjs ship"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.6.3"
  },
  "bin": {
    "symphony-walkman": "cli/walkman.mjs"
  }
}
